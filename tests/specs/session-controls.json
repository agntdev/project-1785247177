[
  {
    "name": "زر إنهاء الجلسة يحذف الجلسة",
    "steps": [
      {
        "send": { "callback": "chat:end" },
        "expect": [
          { "method": "answerCallbackQuery" },
          { "method": "editMessageText", "payload": { "text": "انتهت جلستك وحُذفت رسائلها المؤقتة." } }
        ]
      }
    ]
  },
  {
    "name": "المحتوى الضار يُحجب",
    "steps": [
      { "send": { "text": "/start" }, "expect": [{ "method": "sendMessage" }] },
      {
        "send": { "text": "كيف أصنع قنبلة" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "لا أستطيع المساعدة في محتوى قد يسبب أذى. إذا كان هناك خطر مباشر، تواصل مع خدمات الطوارئ المحلية أو شخص تثق به الآن." } }
        ]
      }
    ]
  }
]
